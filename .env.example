NEXT_PUBLIC_SITE_URL=https://zhanklodmangal.ru

# Yandex Metrika (disabled in `next dev` unless the debug flag is enabled)
NEXT_PUBLIC_YANDEX_METRIKA_ID=111173180
NEXT_PUBLIC_YANDEX_METRIKA_DEBUG=false

# Delivery address suggestions and server-side Haversine distance × 1.3
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
# At least 32 random characters; keep server-side only
DELIVERY_QUOTE_SECRET=

# Email delivery through SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TIMEOUT_MS=12000
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_EMAIL=ogannesigityan@yandex.ru

# Telegram order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT=false
# Production relay for hosts that cannot reach api.telegram.org directly
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=
# Used only outside production. Do not add this variable on Layero.
TELEGRAM_PROXY_URL=
